# Copia este archivo como .env.local (en local) o pon estas variables en Vercel.
# Las encuentras en Supabase > Project Settings > API Keys / Data API.

# URL del proyecto (https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública: "Publishable key" (sb_publishable_...) o la antigua "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta: "Secret key" (sb_secret_...) o la antigua "service_role key".
# ¡NUNCA la compartas ni la pongas con prefijo NEXT_PUBLIC_!
SUPABASE_SECRET_KEY=

# URL pública de tu academia (para los enlaces de recuperar contraseña y mensajes de bienvenida)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
